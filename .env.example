SERVICE_MODE=all
PORT=8080
DATABASE_URL=postgres://rote:rote@localhost:5433/rote

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data
# (selector cache follows STORAGE_BACKEND — no separate CACHE_BACKEND knob)

# Model providers (env-only) — pick per-run via config.model="provider/name". Only for agent/heal/fallback (Phase 4+).
# No default model: a run that needs one with none set fails validation_error (DECISIONS #11).
CONFIG_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                  # optional OpenAI-compatible endpoint override
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=

# Security — SSRF & data handling (Phase 7). Applies to the initial url, replay gotos, AND agent nav.
ALLOW_PRIVATE_TARGETS=false        # dev convenience: permit ALL private hosts (e.g. the 127.0.0.1 fixture)
ALLOWED_PRIVATE_CIDRS=             # prod: allowlist deliberate internal targets, e.g. 10.1.0.0/16,192.168.5.0/24
STORE_RUN_INPUTS=false             # default off → run rows store data KEYS not VALUES (set true only to debug)
CHROMIUM_EXECUTABLE_PATH=          # optional: pin the Chromium binary for the agent browser (Docker uses the image's)

# Concurrency & capacity (per container — enforced from Phase 3)
MAX_CONCURRENT_RUNS=3
MAX_QUEUE_DEPTH=20
RUN_TIMEOUT_SECONDS=180
MAX_RUN_TIMEOUT_SECONDS=600
BROWSER_RECYCLE_RUNS=10
SHUTDOWN_GRACE_SECONDS=25          # graceful-drain window on SIGTERM before forced exit

# Replay LLM extraction fallback + self-heal (Phase 5)
REPLAY_LLM_FALLBACK=off
REPLAY_LLM_FALLBACK_MODEL=          # provider/name, e.g. anthropic/claude-haiku-4-5 (require-explicit)
HEAL_FAILURE_THRESHOLD=3            # consecutive heal failures → playbook health=unhealthy
FALLBACK_AS_DRIFT_SIGNAL=false      # flag a playbook health=needs_relearn after K fallback engagements
FALLBACK_DRIFT_THRESHOLD=5          # K

# Transports & storage backends (Phase 6). SERVICE_MODE=api|worker|all; api enqueues, worker consumes.
SQS_ENABLED=false
SQS_QUEUE_URL=                     # required when SQS_ENABLED — the run queue
SQS_RESULTS_QUEUE_URL=             # optional — publish the terminal envelope here
SQS_VISIBILITY_TIMEOUT_SECONDS=300 # must exceed RUN_TIMEOUT_SECONDS; the consumer heartbeats to extend it
WEBHOOK_MAX_RETRIES=3              # callback_url delivery retries (unsigned in v1 — DECISIONS #30/#32)
# AWS / S3 (STORAGE_BACKEND=s3). A custom endpoint points the same adapters at LocalStack in dev (#29).
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=                  # e.g. http://localhost:4566 for LocalStack; unset → real AWS
S3_BUCKET=
S3_ENDPOINT=                      # optional S3-specific endpoint override (defaults to AWS_ENDPOINT_URL)

# Auth — v1 ships none; api_key/hmac descoped to the gateway (DECISIONS #32)
API_AUTH_MODE=none
